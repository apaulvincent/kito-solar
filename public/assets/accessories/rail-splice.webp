<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 280" width="100%" height="100%" fill="none">
  <defs>
    <linearGradient id="spliceFace" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#E2E8F0"/>
      <stop offset="25%" stop-color="#F8FAFC"/>
      <stop offset="60%" stop-color="#CBD5E1"/>
      <stop offset="100%" stop-color="#94A3B8"/>
    </linearGradient>
    <linearGradient id="railGhost" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#94A3B8" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#475569" stop-opacity="0.15"/>
    </linearGradient>
    <linearGradient id="boltHead" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="50%" stop-color="#94A3B8"/>
      <stop offset="100%" stop-color="#334155"/>
    </linearGradient>
    <filter id="spliceShadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#0F172A" flood-opacity="0.2"/>
    </filter>
  </defs>

  <!-- Ambient Ground Shadow -->
  <ellipse cx="160" cy="225" rx="120" ry="22" fill="#0F172A" opacity="0.15" filter="blur(6px)"/>

  <!-- Ghosted Abutting Rail Profiles (Illustrating Joint) -->
  <g opacity="0.8">
    <!-- Left Rail Segment -->
    <path d="M 30 110 L 155 110 L 155 185 L 30 185 Z" fill="url(#railGhost)" stroke="#64748B" stroke-width="1.5" stroke-dasharray="3 3"/>
    <!-- Right Rail Segment -->
    <path d="M 165 110 L 290 110 L 290 185 L 165 185 Z" fill="url(#railGhost)" stroke="#64748B" stroke-width="1.5" stroke-dasharray="3 3"/>
    <!-- Expansion Gap Indicator (10mm Thermal Gap) -->
    <line x1="160" y1="95" x2="160" y2="200" stroke="#F59E0B" stroke-width="1.5" stroke-dasharray="2 2"/>
    <text x="160" y="85" fill="#F59E0B" font-family="monospace" font-size="9" text-anchor="middle" font-weight="700">EXPANSION JOINT</text>
  </g>

  <!-- High-Tensile Splice Bar Body (150mm Length) -->
  <g filter="url(#spliceShadow)">
    <!-- Main Splice Bar Front Plate -->
    <rect x="70" y="125" width="180" height="48" rx="4" fill="url(#spliceFace)" stroke="#94A3B8" stroke-width="1.2"/>
    
    <!-- Top & Bottom Flange Return Bends -->
    <rect x="70" y="120" width="180" height="6" rx="2" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="0.8"/>
    <rect x="70" y="170" width="180" height="6" rx="2" fill="#64748B" stroke="#475569" stroke-width="0.8"/>

    <!-- Central Alignment Stop Rib -->
    <rect x="158" y="121" width="4" height="54" fill="#334155" rx="1"/>

    <!-- Structural Rib Lines (Anodized Extrusion Grooves) -->
    <line x1="72" y1="135" x2="248" y2="135" stroke="#CBD5E1" stroke-width="1"/>
    <line x1="72" y1="162" x2="248" y2="162" stroke="#94A3B8" stroke-width="1"/>

    <!-- 4x Fastener Assemblies (Self-Drilling Tek Screws) -->
    <!-- Fastener 1 -->
    <g transform="translate(95, 148)">
      <circle cx="0" cy="0" r="10" fill="url(#boltHead)" stroke="#475569" stroke-width="1"/>
      <circle cx="0" cy="0" r="12" fill="none" stroke="#64748B" stroke-width="1" stroke-dasharray="2 2"/>
      <polygon points="0,-4 3.5,-2 3.5,2 0,4 -3.5,2 -3.5,-2" fill="#0F172A"/>
      <circle cx="0" cy="0" r="2" fill="#94A3B8"/>
    </g>

    <!-- Fastener 2 -->
    <g transform="translate(130, 148)">
      <circle cx="0" cy="0" r="10" fill="url(#boltHead)" stroke="#475569" stroke-width="1"/>
      <circle cx="0" cy="0" r="12" fill="none" stroke="#64748B" stroke-width="1" stroke-dasharray="2 2"/>
      <polygon points="0,-4 3.5,-2 3.5,2 0,4 -3.5,2 -3.5,-2" fill="#0F172A"/>
      <circle cx="0" cy="0" r="2" fill="#94A3B8"/>
    </g>

    <!-- Fastener 3 -->
    <g transform="translate(190, 148)">
      <circle cx="0" cy="0" r="10" fill="url(#boltHead)" stroke="#475569" stroke-width="1"/>
      <circle cx="0" cy="0" r="12" fill="none" stroke="#64748B" stroke-width="1" stroke-dasharray="2 2"/>
      <polygon points="0,-4 3.5,-2 3.5,2 0,4 -3.5,2 -3.5,-2" fill="#0F172A"/>
      <circle cx="0" cy="0" r="2" fill="#94A3B8"/>
    </g>

    <!-- Fastener 4 -->
    <g transform="translate(225, 148)">
      <circle cx="0" cy="0" r="10" fill="url(#boltHead)" stroke="#475569" stroke-width="1"/>
      <circle cx="0" cy="0" r="12" fill="none" stroke="#64748B" stroke-width="1" stroke-dasharray="2 2"/>
      <polygon points="0,-4 3.5,-2 3.5,2 0,4 -3.5,2 -3.5,-2" fill="#0F172A"/>
      <circle cx="0" cy="0" r="2" fill="#94A3B8"/>
    </g>
  </g>

  <!-- Technical Spec Indicator Tag -->
  <g transform="translate(20, 24)">
    <rect x="0" y="0" width="105" height="20" rx="4" fill="#0F172A" opacity="0.85"/>
    <text x="52" y="14" fill="#F59E0B" font-family="system-ui, sans-serif" font-size="10" font-weight="700" text-anchor="middle" letter-spacing="0.5">150MM SPLICE KIT</text>
  </g>
</svg>